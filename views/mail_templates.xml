<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mail_notification_layout_trucalc"
              inherit_id="mail.mail_notification_layout"
              name="TruCalc mail notification layout">
        <xpath expr="//td[@t-if='has_button_access']" position="attributes">
            <attribute name="t-att-style">'border-radius: 3px; text-align: center; background: ' + (company.email_secondary_color or '#022f5b') + ';'</attribute>
        </xpath>
        <xpath expr="//div[span[@id='mail_unfollow']]" position="replace">
            <div t-if="show_footer" style="color: #555555; font-size:11px;">
                <span t-if="show_unfollow" id="mail_unfollow">
                    <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                </span>
            </div>
        </xpath>
    </template>

    <template id="mail_notification_light_trucalc"
              inherit_id="mail.mail_notification_light"
              name="TruCalc light mail notification layout">
        <xpath expr="//span[@id='mail_unfollow']/ancestor::tr[1]" position="replace">
            <tr t-if="show_unfollow">
                <td align="center" style="min-width: 590px; color:#555555; font-size:11px;">
                    <span id="mail_unfollow">
                        <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                    </span>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
