<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_layout_brand_identity" inherit_id="web.layout"
              name="TruCalc Browser Identity">
        <xpath expr="//title[@t-esc]" position="attributes">
            <attribute name="t-esc">title or 'TruCalc'</attribute>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/trucalc_branding/static/src/img/favicon.ico'</attribute>
        </xpath>
    </template>

    <template id="login_layout_brand_identity" inherit_id="web.login_layout"
              name="TruCalc Authentication Identity">
        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
            <attribute name="t-attf-class" add="o_trucalc_auth" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('border-top')]/a[contains(@href, 'odoo.com')]"
               position="replace"/>
    </template>

    <template id="frontend_browser_metadata" inherit_id="web.frontend_layout"
              name="TruCalc Frontend Browser Metadata">
        <xpath expr="//meta[@name='viewport']" position="after">
            <meta name="theme-color" content="#022f5b"/>
            <link rel="apple-touch-icon"
                  href="/trucalc_branding/static/src/img/trucalc-icon-ios.png"/>
        </xpath>
    </template>
</odoo>
