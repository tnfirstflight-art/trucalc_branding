<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="digest_mail_main_trucalc"
              inherit_id="digest.digest_mail_main"
              name="TruCalc digest mail content">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' by_odoo ')]/a[contains(@href, 'odoo.com')]"
               position="replace">
            <span class="odoo_link_text">TruCalc</span>
        </xpath>
        <xpath expr="//tr[@t-if='display_mobile_banner']" position="replace"/>
        <xpath expr="//p[@id='powered']" position="replace"/>
    </template>
</odoo>
